# Console (admin) frontend environment variables.
# Copy to .env.local for local development.

# --- Auth Worker ---
# Where the Better Auth worker lives. The console's AuthGuard, JWT fetch,
# and sign-out flow all target `${VITE_AUTH_BASE_URL}/api/auth/*` with
# `credentials: "include"`, so a same-site cookie has to be reachable.
#
# Production: https://auth.bridgingchina.net
#
# Local dev note: the browser will not send the auth Worker's
# `.bridgingchina.net` cookie to `localhost:5173`. For an end-to-end local
# flow you need one of:
#   (a) point `VITE_AUTH_BASE_URL` at a wrangler `--local` auth Worker
#       that sets cookies for `localhost` directly, or
#   (b) add `console.bridgingchina.net` to /etc/hosts (127.0.0.1) and run
#       the Vite dev server behind an HTTPS proxy on that hostname.
VITE_AUTH_BASE_URL=https://auth.bridgingchina.net

# --- FastAPI backend proxy ---
# Used by the Vite dev server to proxy /api/* to the backend. In Docker
# this is set to the service name (bridge_rag_api); outside Docker, leave
# empty to fall back to http://localhost:8000.
# VITE_API_PROXY_TARGET=http://localhost:8000

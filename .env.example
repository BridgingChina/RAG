DATABASE_URL=postgresql+psycopg://bridge:bridge@localhost:5433/bridge_rag
ZHIPU_API_KEY=your_api_key_here
SECRET_KEY=change-me-in-production

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bridge-rag
R2_PUBLIC_URL=

# Zhipu file parser
ZHIPU_PARSER_TOOL_TYPE=expert

# LLM for test doc generation (OpenAI-compatible)
